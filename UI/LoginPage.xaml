<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CafeApp.Models"
             x:Class="CafeApp.UI.LoginPage"
             BackgroundColor="#1A1A2E">

    <Grid>
    <ScrollView>
        <VerticalStackLayout Spacing="15" Padding="30" VerticalOptions="Center" MaximumWidthRequest="500" HorizontalOptions="Center">
            
            <!-- Logo & Başlık -->
            <Label Text="☕" FontSize="72" HorizontalOptions="Center" Margin="0,0,0,-10"/>
            <Label Text="CafeApp POS" FontSize="36" FontAttributes="Bold" TextColor="#E94560" HorizontalOptions="Center" />
            <Label Text="Personel Giriş Sistemi" FontSize="16" TextColor="#8D8DAA" HorizontalOptions="Center" Margin="0,0,0,10"/>

            <!-- Personel Listesi -->
            <Label Text="Personel seçin:" TextColor="#8D8DAA" FontSize="14" Margin="5,0,0,0"/>
            <CollectionView x:Name="PersonelListesi" 
                            HeightRequest="220"
                            SelectionMode="Single"
                            SelectionChanged="OnPersonelSecildi">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Personel">
                        <Border Margin="3" Padding="12,10" 
                                StrokeShape="RoundRectangle 10"
                                Stroke="#0F3460"
                                BackgroundColor="#0F3460">
                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10">
                                <Label Grid.Column="0" Text="👤" FontSize="20" VerticalOptions="Center"/>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                    <Label Text="{Binding TamAd}" TextColor="White" FontSize="16" FontAttributes="Bold"/>
                                    <Label Text="{Binding RolMetni}" TextColor="#8D8DAA" FontSize="12"/>
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="›" TextColor="#8D8DAA" FontSize="22" VerticalOptions="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <Label Text="Personel bulunamadı.&#10;Veritabanı bağlantısını kontrol edin." 
                           TextColor="#E94560" HorizontalTextAlignment="Center" Margin="20" FontSize="14"/>
                </CollectionView.EmptyView>
            </CollectionView>

            <!-- Seçilen Personel Göstergesi -->
            <Border x:Name="SecimBorder" BackgroundColor="#0F3460" 
                    StrokeShape="RoundRectangle 10" Stroke="#E94560" 
                    Padding="12" IsVisible="False">
                <Label x:Name="SecimLabel" Text="" TextColor="White" FontSize="15" HorizontalTextAlignment="Center"/>
            </Border>

            <!-- Giriş Butonu -->
            <Button x:Name="GirisButonu" Text="Sisteme Giriş Yap" 
                    BackgroundColor="#E94560" 
                    TextColor="White" 
                    FontAttributes="Bold" 
                    FontSize="18" 
                    CornerRadius="12" 
                    HeightRequest="55" 
                    IsEnabled="False"
                    Opacity="0.5"
                    Clicked="OnGirisYapClicked"/>

            <!-- Alt bilgi -->
            <Label Text="v2.0 — N-Katmanlı Mimari" FontSize="12" TextColor="#533483" HorizontalOptions="Center" Margin="0,20,0,0"/>
            
        </VerticalStackLayout>
    </ScrollView>

    <!-- Şifre Overlay -->
    <Grid x:Name="SifreOverlay" IsVisible="False"
          BackgroundColor="#AA000000"
          HorizontalOptions="Fill" VerticalOptions="Fill">
        <Frame BackgroundColor="#16213E" CornerRadius="16" Padding="25"
               HorizontalOptions="Center" VerticalOptions="Center"
               WidthRequest="300" BorderColor="#E94560">
            <VerticalStackLayout Spacing="15">
                <Label Text="🔐 Yönetici Girişi" FontSize="20" FontAttributes="Bold"
                       TextColor="White" HorizontalTextAlignment="Center"/>
                <Label Text="Şifrenizi girin:" TextColor="#8D8DAA" FontSize="14"/>
                <Entry x:Name="SifreEntry" IsPassword="True"
                       Placeholder="••••••" PlaceholderColor="#533483"
                       TextColor="White" BackgroundColor="#0F3460"
                       FontSize="18" HeightRequest="48"/>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Grid.Column="0" Text="İptal"
                            BackgroundColor="#0F3460" TextColor="White"
                            CornerRadius="10" HeightRequest="44"
                            Clicked="OnSifreIptalClicked"/>
                    <Button Grid.Column="1" Text="Giriş"
                            BackgroundColor="#E94560" TextColor="White"
                            CornerRadius="10" HeightRequest="44"
                            Clicked="OnSifreOnayClicked"/>
                </Grid>
            </VerticalStackLayout>
        </Frame>
    </Grid>

    </Grid>
</ContentPage>