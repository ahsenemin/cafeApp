<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:CafeApp.Converters"
             xmlns:models="clr-namespace:CafeApp.Models"
             x:Class="CafeApp.UI.GarsonPage"
             Title="Restoran Masaları"
             BackgroundColor="#1A1A2E">

    <ContentPage.Resources>
        <conv:DurumRenkConverter x:Key="RenkCevirici"/>
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Çıkış" Clicked="OnCikisClicked"/>
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto, *" Padding="15">
        
        <!-- Üst Bilgi Bandı -->
        <Frame Grid.Row="0" BackgroundColor="#16213E" CornerRadius="12" Padding="15" Margin="0,0,0,10" BorderColor="Transparent">
            <Grid ColumnDefinitions="*, Auto">
                <VerticalStackLayout Grid.Column="0">
                    <Label x:Name="HosgeldinLabel" FontSize="14" TextColor="#8D8DAA"/>
                    <Label Text="☕ Masa Durumları" FontSize="22" FontAttributes="Bold" TextColor="White"/>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                    <Label Text="🟢 Boş  🔴 Dolu  🟠 Rezerve" FontSize="11" TextColor="#8D8DAA"/>
                </VerticalStackLayout>
            </Grid>
        </Frame>

        <!-- Masa Grid'i -->
        <CollectionView x:Name="MasalarListesi" Grid.Row="1">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical"
                        Span="3"
                        VerticalItemSpacing="10"
                        HorizontalItemSpacing="10"/>
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Masa">
                    <Frame CornerRadius="14"
                           BackgroundColor="{Binding Durum, Converter={StaticResource RenkCevirici}}"
                           Padding="15"
                           HasShadow="True"
                           BorderColor="Transparent">

                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMasaTapped"/>
                        </Frame.GestureRecognizers>

                        <VerticalStackLayout HorizontalOptions="Center"
                                VerticalOptions="Center"
                                Spacing="4">
                            <Label Text="{Binding MasaNo}"
                                    FontSize="20"
                                    FontAttributes="Bold"
                                    TextColor="White"
                                    HorizontalOptions="Center"/>
                            <Label Text="{Binding DurumMetni}"
                                    FontSize="13"
                                    TextColor="#FFFFFFCC"
                                    HorizontalOptions="Center"/>
                            <Label Text="{Binding MasaToplamFiyati, StringFormat='{0:C2}'}"
                                    FontSize="16"
                                    TextColor="White"
                                    HorizontalOptions="Center"
                                    FontAttributes="Bold"/>
                        </VerticalStackLayout>

                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>